#!/usr/bin/env sh

# Cross platform clipboard-copy helper
#
# Dependencies
# Windows: `Win32Yank` or `pasteboard` package
# Linux: `xsel`. Install xsel from your package manager e.g. `sudo apt install xsel`

# About variables: See detection script

# NOTE: this won't work using -n and checking for existance of
# arguments first like piping into pbcopy.exe
# It should always check if no argument is passed with -z
if [ -z "$*" ]; then
  # Should take input from pipe
  if [ "$IS_WSL2" = true ]; then
    if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy 1>/dev/null 2>&1; then
      # wl-copy --foreground --type text/plain
      wl-copy
    elif [ -n "$DISPLAY" ] && command -v xsel 1>/dev/null 2>&1; then
      xsel -i -b
    elif [ -n "$DISPLAY" ] && command -v xclip 1>/dev/null 2>&1; then
      xclip -i -selection clipboard
    elif command -v win32yank.exe 1>/dev/null 2>&1; then
      win32yank.exe -i
    elif command -v pbcopy.exe 1>/dev/null 2>&1; then
      pbcopy.exe
    else
      powershell.exe -NoLogo -NonInteractive -NoProfile -Command Set-Clipboard
    fi
  elif [ "$OS" = 'Windows_NT' ] || [ "$IS_WSL1" = true ]; then
    if command -v win32yank.exe 1>/dev/null 2>&1; then
      win32yank.exe -i
    elif command -v pbcopy.exe 1>/dev/null 2>&1; then
      pbcopy.exe
    else
      powershell.exe -NoLogo -NonInteractive -NoProfile -Command Set-Clipboard
    fi
  elif [ "$IS_TERMUX" = true ]; then
    termux-clipboard-set
  elif [ "$IS_MAC" = true ]; then
    pbcopy
  elif [ "$IS_LINUX" = true ]; then
    if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy 1>/dev/null 2>&1; then
      wl-copy --foreground --type text/plain
    elif [ -n "$DISPLAY" ] && command -v xsel 1>/dev/null 2>&1; then
      xsel -i -b
    elif [ -n "$DISPLAY" ] && command -v xclip 1>/dev/null 2>&1; then
      xclip -i -selection clipboard
    fi
  fi

  exit 0
fi

# Passed arguments
if [ "$IS_WSL2" = true ]; then
  if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy 1>/dev/null 2>&1; then
    wl-copy --foreground --type text/plain "$@"
  elif [ -n "$DISPLAY" ] && command -v xsel 1>/dev/null 2>&1; then
    printf '%s' "$@" | xsel -i -b
  elif [ -n "$DISPLAY" ] && command -v xclip 1>/dev/null 2>&1; then
    printf '%s' "$@" | xclip -i -selection clipboard
  elif command -v win32yank.exe 1>/dev/null 2>&1; then
    printf '%s' "$@" | win32yank.exe -i
  elif command -v pbcopy.exe 1>/dev/null 2>&1; then
    printf "%s" "$@" | pbcopy.exe
  else
    powershell.exe -NoLogo -NonInteractive -NoProfile -Command "Set-Clipboard -Value '$*'"
  fi
elif [ "$OS" = 'Windows_NT' ] || [ "$IS_WSL1" = true ]; then
  if command -v win32yank.exe 1>/dev/null 2>&1; then
    printf '%s' "$@" | win32yank.exe -i
  elif command -v pbcopy.exe 1>/dev/null 2>&1; then
    printf '%s' "$@" | pbcopy.exe
  else
    powershell.exe -NoLogo -NonInteractive -NoProfile -Command "Set-Clipboard -Value '$*'"
  fi
elif [ "$IS_TERMUX" = true ]; then
  termux-clipboard-set "$@"
elif [ "$IS_MAC" = true ]; then
  printf '%s' "$@" | pbcopy
elif [ "$IS_LINUX" = true ]; then
  if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy 1>/dev/null 2>&1; then
    # wl-copy --foreground --type text/plain "$@"
    wl-copy "$@"
  elif [ -n "$DISPLAY" ] && command -v xsel 1>/dev/null 2>&1; then
    printf '%s' "$@" | xsel -i -b
  elif [ -n "$DISPLAY" ] && command -v xclip 1>/dev/null 2>&1; then
    printf '%s' "$@" | xclip -i -selection clipboard
  fi
fi
