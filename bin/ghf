#!/usr/bin/env bash

expect_keys="${GHF_EXPECT:-}"
delegate_output=false
display=false
files_preview_pr=''
[[ -v GHF_EXPECT ]] && delegate_output=true

show_help () {
  printf '%s\n' '
Usage: ghf [options]

Options:
  -d, --display    Make fzf fill the current terminal.
  --expect [keys]  Replace fzf expected keys and print the pressed key followed
                   by the selected PR number. Also available through GHF_EXPECT.
  -h, --help       Show this help message.
'
}

show_pr_files () {
  local pr_info pr_id pr_url github_host

  pr_info="$(GH_FORCE_TTY= gh pr view "$1" --json id,url --jq '[.id, .url] | @tsv')" || return
  IFS=$'\t' read -r pr_id pr_url <<< "$pr_info"
  github_host="${pr_url#*://}"
  github_host="${github_host%%/*}"

  GH_FORCE_TTY= gh api graphql \
    --hostname "$github_host" \
    --paginate \
    -F "id=$pr_id" \
    -f 'query=query($id: ID!, $endCursor: String) { node(id: $id) { ... on PullRequest { files(first: 100, after: $endCursor) { nodes { path changeType } pageInfo { hasNextPage endCursor } } } } }' \
    --jq '.data.node.files.nodes[] |
      (if .changeType == "DELETED" then "REMOVED" else .changeType end) as $status |
      (if $status == "ADDED" then "32"
       elif $status == "MODIFIED" then "33"
       elif $status == "REMOVED" then "31"
       elif $status == "RENAMED" then "36"
       else "35"
       end) as $color |
      ("[" + $status + "]") as $label |
      "\u001b[" + $color + "m" + $label + "\u001b[0m" +
      (" " * (10 - ($label | length))) + "\t" + .path'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -[dD]|-[dD]isplay|--[dD]isplay)
      display=true
      shift
      ;;
    --[eE]xpect)
      if [[ $# -lt 2 ]]; then
        printf '%s\n' 'ghf: --expect requires a value' >&2
        exit 2
      fi
      expect_keys="$2"
      delegate_output=true
      shift 2
      ;;
    --files-preview)
      if [[ $# -lt 2 ]]; then
        printf '%s\n' 'ghf: --files-preview requires a PR number' >&2
        exit 2
      fi
      files_preview_pr="$2"
      shift 2
      ;;
    -[hH]|--[hH]elp)
      show_help
      exit
      ;;
    *)
      printf 'ghf: unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

if ! command -v 'gh' &>/dev/null; then
  printf '%s\n' 'No github cli available'
  exit 1
fi

if [ -n "$files_preview_pr" ]; then
  show_pr_files "$files_preview_pr"
  exit
fi

if [ "$delegate_output" = true ]; then
  expect_keys="${expect_keys:-enter}"
  fzf_expect_keys="ctrl-f,$expect_keys"
else
  fzf_expect_keys='ctrl-f,ctrl-s,ctrl-d'
fi

preview='GH_FORCE_TTY=$FZF_PREVIEW_COLUMNS gh pr view {1}'
diff_preview='gh pr diff {1} --color=always'
if command -v 'delta' &>/dev/null; then
  diff_preview="$diff_preview | delta"
fi
printf -v ghf_command '%q' "$0"
files_preview="$ghf_command --files-preview {1}"

help_cat_cmd='cat'
if command -v 'bat' &>/dev/null; then
  help_cat_cmd='bat --color=always --language help --style=plain'
fi

help_cmd="
  $help_cat_cmd <<< '
  Preview window keys:
    ctrl-^: Toggle preview
    ctrl-/: Toggle preview position
    shift-up: Preview up
    shift-down: Preview down
    alt-up: Preview page up
    alt-down: Preview page down

  Preview modes:
    alt-v: PR details (default)
    alt-d: PR code changes (delta when available)
    alt-g: Status and names of changed files

  PR actions:
    enter: Select PR
    ctrl-d: Display PR details
    ctrl-o: Open PR in browser
    ctrl-s: Checkout PR

  Navigation:
    ctrl-f: Filter PRs
    alt-n: Load next page
    alt-f: Go first
    alt-l: Go last
    alt-c: Clear query
  '
"

commond_options=(
  --bind 'alt-c:clear-query'
  --bind 'ctrl-l:change-preview-window(down,wrap-word|hidden|)'
  --bind 'ctrl-/:change-preview-window(down,wrap-word|hidden|)'
  --bind 'alt-up:preview-page-up,alt-down:preview-page-down'
  --bind 'shift-up:preview-up,shift-down:preview-down'
  --bind 'ctrl-^:toggle-preview'
  --bind 'ctrl-s:toggle-sort'
  --bind 'alt-f:first'
  --bind 'alt-l:last'
  --cycle
  --ansi
  --input-border=rounded
  --no-multi
  --accept-nth '{1}'
  --with-shell 'bash -c'
)

if [ "$display" = true ]; then
  if [ "${OS:-}" = 'Windows_NT' ]; then
    # At exactly 100%, fzf's tcell renderer can miss ctrl-/ and ctrl-^ on
    # Windows terminals.
    commond_options+=(--height '99%')
  else
    commond_options+=(--height '100%')
  fi
fi

filters=(
  '0 Assigned to me'
  '1 Created by me'
  '2 Needs my review'
  '3 Draft PRs only'
  '4 Ready PRs only'
  '5 Merged PRs'
  '6 Closed PRs'
)
filter_cmds=(
  '--assigned @me'
  '--author @me'
  "--search 'review-requested:@me'"
  '--draft'
  "--search 'draft:false'"
  '--state merged'
  '--state closed'
)
prompt_cmds=(
  'Assigned PRs> '
  'Author PRs> '
  'Need Review> '
  'Draft PRs> '
  'Ready PRs> '
  'Merged PRs> '
  'Closed PRs> '
)

select_filter () {
  local filter
  filter="$(printf '%s\n' "${filters[@]}" | fzf \
    --header 'esc: No filter' \
    --no-multi \
    --cycle \
    --with-nth '2..' \
    "${commond_options[@]}"
  )"

  if [ -n "$filter" ]; then
    local cmd="gh pr list ${filter_cmds[$filter]}" 
    show_prs "$cmd" "${prompt_cmds[$filter]}"
    return
  fi

  show_prs
}

show_prs () {
  local cmd="${1:-gh pr list}"
  local prompt="${2:-Github PRs> }"
  local page_size=30
  local pipe_cmd="$cmd --limit $page_size | awk '\$0'"
  local next_page_cmd="$cmd --limit \$((FZF_TOTAL_COUNT + $page_size)) | awk '\$0'"

  mapfile -t selected < <(GH_FORCE_TTY='100%' fzf \
    --bind "start:reload:$pipe_cmd" \
    --bind "alt-n:reload-sync:$next_page_cmd" \
    --bind 'ctrl-o:execute-silent:gh pr view {1} --web' \
    --bind "alt-h:preview:$help_cmd" \
    --bind "alt-v:change-preview:$preview" \
    --bind "alt-d:change-preview:$diff_preview" \
    --bind "alt-g:change-preview:$files_preview" \
    --header 'alt-h: Help | alt-v: Details | alt-d: Diff | alt-g: Files | alt-n: Next page | ctrl-f: Filter' \
    --expect="$fzf_expect_keys" \
    --header-border 'rounded' \
    --header-lines '2' \
    --header-lines-border 'bottom' \
    --track \
    --id-nth '1' \
    --prompt "$prompt" \
    --preview "$preview" \
    --preview-window '50%,wrap-word' \
    --preview-border 'rounded' \
    "${commond_options[@]}"
  )

  if [ "$delegate_output" = true ] && [ "${selected[0]}" != ctrl-f ]; then
    if [ -n "${selected[1]:-}" ]; then
      printf '%s\n' "${selected[@]}"
    fi
    return
  fi

  case "${selected[0]}" in
    ctrl-f)
      select_filter
      ;;
    ctrl-s)
      gh pr checkout "${selected[1]}"
      ;;
    ctrl-d)
      gh pr view "${selected[1]}"
      ;;
    *)
      printf '%s\n' "${selected[1]}"
      ;;
  esac
}

show_prs
