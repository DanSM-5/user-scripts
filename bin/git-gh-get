#!/usr/bin/env bash
#
# git-gh-get — Download files from Git forges without cloning
#
# Usage: git gh-get <source> [dest] [options]

set -euo pipefail

_script_dir() {
  local source_file="${BASH_SOURCE[0]}" directory
  while [[ -h $source_file ]]; do
    directory=$(cd -P "$(dirname "$source_file")" && pwd)
    source_file=$(readlink "$source_file")
    [[ $source_file == /* ]] || source_file="$directory/$source_file"
  done
  cd -P "$(dirname "$source_file")" && pwd
}

readonly SCRIPT_DIR=$(_script_dir)
# shellcheck source=lib/git-forge.sh
source "$SCRIPT_DIR/lib/git-forge.sh"

readonly PROG='git-gh-get'
readonly GITHUB_API='https://api.github.com'

FORGE_TYPE=''
FORGE_HOST=''
FORGE_ORIGIN=''
FORGE_OPTION=''
OPTION_FORGE_TYPE=''
OPTION_FORGE_HOST=''
OPTION_FORGE_ORIGIN=''
REPOSITORY_PATH=''
SOURCE_REF=''
SOURCE_REF_KIND=''
SOURCE_OID=''
SOURCE_PATH=''
REMOTE_URL=''
USE_GH=true
DRY_RUN=false
COLOR_MODE='auto'
DRY_RUN_URLS=()
DRY_RUN_DESTINATIONS=()
DRY_RUN_WARNING_PATHS=()

die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
info() { printf '%s: %s\n' "$PROG" "$*" >&2; }

_has_gh() {
  [[ $FORGE_TYPE == github && $USE_GH == true ]] && command -v gh &>/dev/null
}

show_help() {
  cat <<'EOF'
Usage: git gh-get <source> [dest] [options]

Download a file or directory from GitHub or a public GitLab, Forgejo, or Gitea
repository without cloning it.

Arguments:
  source   A native forge URL, or a path whose forge is supplied by --forge.
           Existing GitHub shortcuts remain supported.

           GitHub:
             username/repo/path/to/file.txt
             https://github.com/user/repo/blob/main/path/to/file.txt
             https://raw.githubusercontent.com/user/repo/main/path/to/file.txt

           GitLab (nested groups are supported):
             https://gitlab.com/group/repo/-/blob/main/path/to/file.txt
             https://gitlab.com/group/subgroup/repo/-/tree/main/path
             --forge gitlab.com group/repo/-/raw/main/path/to/file.txt

           Forgejo/Gitea:
             https://codeberg.org/owner/repo/src/branch/main/path/to/file.txt
             https://gitea.com/owner/repo/src/tag/v1.0.0/path/to/file.txt
             --forge codeberg.org owner/repo/src/branch/main/path/to/file.txt

  dest     Output path (default: current directory).
             Trailing slash  -> save inside directory, preserve original name.
             Existing dir    -> save inside directory, preserve original name.
             Non-existing    -> use as the output filename (parent dirs created).

Options:
  -c, --container       Download a directory recursively (requires jq or Python)
  --dry-run             Print each resolved URL and destination without downloading
  --color=<mode>        Dry-run table mode: auto, always, or never (default: auto).
                       auto uses gum on a TTY when available; always uses gum when
                       available even if redirected; never emits parseable TSV.
  --forge <host|name>   Identify the forge for a hostless source. Known names are
                       github, gitlab, forgejo, and gitea; a known hostname is
                       preferred when it identifies the intended public instance.
  --gh                  Use gh CLI for GitHub if available (default)
  --no-gh               Skip gh CLI for GitHub; use curl/wget instead
                       (both options are no-ops for non-GitHub forges)
  -h, --help            Show this help

Environment:
  GITHUB_TOKEN   Personal access token for private GitHub repositories

Notes:
  Non-GitHub support currently targets public repositories. Native blob/raw/tree
  URL forms are supported; ambiguous markerless non-GitHub file shortcuts are not.
  A matching branch/tag prefix wins over a same-named default-branch path.
  A leading 7-40 character hexadecimal component is treated as a commit SHA.
  When a branch and tag share a name, the branch is preferred.

Examples:
  git gh-get username/repo/src/main.js
  git gh-get https://gitlab.com/group/repo/-/blob/main/README.md ./docs/
  git gh-get --forge codeberg.org owner/repo/src/branch/main/README.md
  git gh-get -c https://codeberg.org/owner/repo/src/branch/main/docs ./docs/
  git gh-get --dry-run https://gitlab.com/group/repo/-/raw/main/file.txt
EOF
}

# ── JSON helpers ──────────────────────────────────────────────────────────────

json_field() {
  local key="$1"
  if command -v jq &>/dev/null; then
    jq -r --arg key "$key" '.[$key] | if . == null then empty else tostring end'
  elif command -v python3 &>/dev/null; then
    python3 -c 'import json,sys
value=json.load(sys.stdin).get(sys.argv[1])
if value is not None:
 print(str(value).lower() if isinstance(value,bool) else value)' "$key"
  elif command -v python &>/dev/null; then
    python -c 'import json,sys
value=json.load(sys.stdin).get(sys.argv[1])
if value is not None:
 print(str(value).lower() if isinstance(value,bool) else value)' "$key"
  else
    grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" |
      head -1 | sed -E "s/^\"$key\"[[:space:]]*:[[:space:]]*\"//; s/\"$//"
  fi
}

json_array_length() {
  if command -v jq &>/dev/null; then
    jq -r 'length'
  elif command -v python3 &>/dev/null; then
    python3 -c 'import json,sys; print(len(json.load(sys.stdin)))'
  elif command -v python &>/dev/null; then
    python -c 'import json,sys; print(len(json.load(sys.stdin)))'
  else
    die 'jq or Python is required for directory downloads'
  fi
}

# Read GitHub/Forgejo tree JSON and list blob paths below a prefix.
json_tree_paths() {
  local prefix="$1"
  if command -v jq &>/dev/null; then
    jq -r --arg prefix "$prefix" '
      (.tree // [])[]
      | select(.type == "blob")
      | select($prefix == "" or .path == $prefix or (.path | startswith($prefix + "/")))
      | .path'
  elif command -v python3 &>/dev/null; then
    python3 - "$prefix" <<'PYEOF'
import json, sys
prefix = sys.argv[1]
for item in (json.load(sys.stdin).get('tree') or []):
    path = item.get('path', '')
    if item.get('type') == 'blob' and (not prefix or path == prefix or path.startswith(prefix + '/')):
        print(path)
PYEOF
  elif command -v python &>/dev/null; then
    python - "$prefix" <<'PYEOF'
import json, sys
prefix = sys.argv[1]
for item in (json.load(sys.stdin).get('tree') or []):
    path = item.get('path', '')
    if item.get('type') == 'blob' and (not prefix or path == prefix or path.startswith(prefix + '/')):
        print(path)
PYEOF
  else
    die 'jq or Python is required for directory downloads'
  fi
}

# Read one GitLab repository-tree page and list blob paths.
json_gitlab_tree_paths() {
  if command -v jq &>/dev/null; then
    jq -r '.[] | select(.type == "blob") | .path'
  elif command -v python3 &>/dev/null; then
    python3 -c 'import json,sys
for item in json.load(sys.stdin):
 if item.get("type") == "blob": print(item.get("path", ""))'
  elif command -v python &>/dev/null; then
    python -c 'import json,sys
for item in json.load(sys.stdin):
 if item.get("type") == "blob": print(item.get("path", ""))'
  else
    die 'jq or Python is required for directory downloads'
  fi
}

# ── Forge and source parsing ──────────────────────────────────────────────────

_join_with_slash() {
  local IFS='/'
  printf '%s' "$*"
}

_url_authority() {
  local value="${1#*://}"
  printf '%s' "${value%%/*}"
}

_url_host() {
  local authority
  authority=$(_url_authority "$1")
  authority="${authority##*@}"
  if [[ $authority == \[*\]* ]]; then
    authority="${authority#\[}"
    printf '%s' "${authority%%\]*}"
  else
    printf '%s' "${authority%%:*}"
  fi
}

_url_origin() {
  local scheme="${1%%://*}" authority
  authority=$(_url_authority "$1")
  printf '%s://%s' "$scheme" "$authority"
}

_url_path() {
  local value="${1#*://}"
  if [[ $value == */* ]]; then
    printf '%s' "${value#*/}"
  fi
}

resolve_forge_option() {
  [[ -n $FORGE_OPTION ]] || return 0

  local specification="${FORGE_OPTION%/}" lookup="$FORGE_OPTION"
  if [[ $specification == *://* ]]; then
    lookup=$(_url_host "$specification")
  fi

  git_forge_find_named_resolver "$lookup" ||
    die "Unknown forge '$FORGE_OPTION' (use a known host or github/gitlab/forgejo/gitea)"

  OPTION_FORGE_TYPE="$GIT_FORGE_MATCHED_TYPE"
  OPTION_FORGE_ORIGIN="$GIT_FORGE_MATCHED_ORIGIN"
  if [[ $specification == *://* ]]; then
    OPTION_FORGE_ORIGIN=$(_url_origin "$specification")
    OPTION_FORGE_HOST=$(_url_host "$specification")
  else
    OPTION_FORGE_HOST=$(_url_host "$OPTION_FORGE_ORIGIN")
  fi
}

set_source_forge() {
  local host="$1" origin="$2" detected_type='' detected_origin=''

  if git_forge_find_resolver "$host"; then
    detected_type="$GIT_FORGE_MATCHED_TYPE"
    detected_origin="$GIT_FORGE_MATCHED_ORIGIN"
  elif [[ -n $OPTION_FORGE_TYPE ]]; then
    detected_type="$OPTION_FORGE_TYPE"
  else
    die "Unsupported forge host '$host'; pass --forge with a supported forge type"
  fi

  if [[ -n $OPTION_FORGE_TYPE && $detected_type != "$OPTION_FORGE_TYPE" ]]; then
    die "Source host '$host' does not match --forge '$FORGE_OPTION'"
  fi

  FORGE_TYPE="$detected_type"
  FORGE_HOST="$host"
  FORGE_ORIGIN="${origin:-$detected_origin}"
}

github_matching_refs_json() {
  local ref_type="$1" first="$2"
  local owner="${REPOSITORY_PATH%%/*}" repository="${REPOSITORY_PATH#*/}"
  local endpoint="repos/$owner/$repository/git/matching-refs/$ref_type/$first"
  local token="${GITHUB_TOKEN:-}" response=''

  if _has_gh; then
    response=$(gh api "$endpoint" 2>/dev/null) || response='[]'
  elif command -v curl &>/dev/null; then
    local args=(-sf)
    [[ -n $token ]] && args+=(-H "Authorization: Bearer $token")
    response=$(curl "${args[@]}" "$GITHUB_API/$endpoint" 2>/dev/null) || response='[]'
  elif command -v wget &>/dev/null; then
    local args=(-qO-)
    [[ -n $token ]] && args+=(--header="Authorization: Bearer $token")
    response=$(wget "${args[@]}" "$GITHUB_API/$endpoint" 2>/dev/null) || response='[]'
  else
    response='[]'
  fi
  printf '%s' "$response"
}

github_ref_names_from_json() {
  local prefix="$1"
  if command -v jq &>/dev/null; then
    jq -r --arg prefix "$prefix" '.[].ref | ltrimstr($prefix)' 2>/dev/null || true
  elif command -v python3 &>/dev/null; then
    python3 -c 'import json,sys
prefix=sys.argv[1]
try:
 for item in json.load(sys.stdin):
  ref=item.get("ref", "")
  print(ref[len(prefix):] if ref.startswith(prefix) else ref)
except Exception: pass' "$prefix" 2>/dev/null || true
  elif command -v python &>/dev/null; then
    python -c 'import json,sys
prefix=sys.argv[1]
try:
 for item in json.load(sys.stdin):
  ref=item.get("ref", "")
  print(ref[len(prefix):] if ref.startswith(prefix) else ref)
except Exception: pass' "$prefix" 2>/dev/null || true
  else
    grep -o '"ref"[[:space:]]*:[[:space:]]*"[^"]*"' |
      sed -E 's/^"ref"[[:space:]]*:[[:space:]]*"//; s/"$//' |
      sed "s#^$prefix##"
  fi
}

# Emit kind, name, object ID, and peeled marker as tab-separated records.
matching_ref_records() {
  local first="$1" only_kind="${2:-}" ref_type kind response ref_name oid full_ref peeled

  if [[ $FORGE_TYPE == github ]]; then
    for ref_type in heads tags; do
      kind=${ref_type%?}
      [[ $ref_type == heads ]] && kind='branch'
      [[ -n $only_kind && $only_kind != "$kind" ]] && continue
      response=$(github_matching_refs_json "$ref_type" "$first")
      while IFS= read -r ref_name; do
        [[ -n $ref_name ]] && printf '%s\t%s\t\tfalse\n' "$kind" "$ref_name"
      done < <(printf '%s' "$response" | github_ref_names_from_json "refs/$ref_type/")
    done
    return
  fi

  for ref_type in heads tags; do
    kind=${ref_type%?}
    [[ $ref_type == heads ]] && kind='branch'
    [[ -n $only_kind && $only_kind != "$kind" ]] && continue
    response=$(git ls-remote "--$ref_type" "$REMOTE_URL" "refs/$ref_type/$first*" 2>/dev/null) || response=''
    while read -r oid full_ref; do
      [[ -n ${full_ref:-} ]] || continue
      peeled=false
      if [[ $full_ref == *'^{}' ]]; then
        full_ref="${full_ref%'^{}'}"
        peeled=true
      fi
      ref_name="${full_ref#"refs/$ref_type/"}"
      printf '%s\t%s\t%s\t%s\n' "$kind" "$ref_name" "$oid" "$peeled"
    done <<< "$response"
  done
}

# Split ref[/with/slashes]/path using the longest branch/tag prefix. When an
# explicit native URL marker is present, assume_ref makes an unresolved first
# component the ref. Otherwise the value is a default-branch path.
resolve_ref_path() {
  local remaining="${1%/}" assume_ref="${2:-true}" only_kind="${3:-}"
  SOURCE_REF=''
  SOURCE_REF_KIND=''
  SOURCE_OID=''
  SOURCE_PATH=''

  [[ -n $remaining ]] || return 0

  local -a parts=()
  IFS='/' read -ra parts <<< "$remaining"
  local count=${#parts[@]} first="${parts[0]}"

  if [[ $first =~ ^[0-9a-fA-F]{7,40}$ ]]; then
    SOURCE_REF="$first"
    SOURCE_REF_KIND='commit'
    SOURCE_OID="$first"
    SOURCE_PATH=$(_join_with_slash "${parts[@]:1}")
    return
  fi

  # Preserve the original GitHub shortcut behavior for a lone explicit ref.
  if [[ $FORGE_TYPE == github && $assume_ref == true && $count -eq 1 ]]; then
    SOURCE_REF="$first"
    SOURCE_REF_KIND="${only_kind:-ref}"
    return
  fi

  local found_ref='' found_path='' found_kind='' found_oid=''
  local kind name oid peeled
  while IFS=$'\t' read -r kind name oid peeled; do
    [[ -n $name ]] || continue
    local candidate_path=''
    if [[ $remaining == "$name" ]]; then
      candidate_path=''
    elif [[ $remaining == "$name/"* ]]; then
      candidate_path="${remaining#"$name/"}"
    else
      continue
    fi

    if [[ ${#name} -gt ${#found_ref} ]]; then
      found_ref="$name"
      found_path="$candidate_path"
      found_kind="$kind"
      found_oid="$oid"
    elif [[ $name == "$found_ref" && $kind == "$found_kind" && $peeled == true ]]; then
      found_oid="$oid"
    fi
  done < <(matching_ref_records "$first" "$only_kind")

  if [[ -n $found_ref ]]; then
    SOURCE_REF="$found_ref"
    SOURCE_REF_KIND="$found_kind"
    SOURCE_OID="$found_oid"
    SOURCE_PATH="$found_path"
  elif [[ $assume_ref == true ]]; then
    SOURCE_REF="$first"
    SOURCE_REF_KIND="${only_kind:-ref}"
    SOURCE_PATH=$(_join_with_slash "${parts[@]:1}")
  else
    SOURCE_PATH="$remaining"
  fi
}

parse_github_path() {
  local path="${1#/}" raw_host="${2:-false}"
  local -a parts=()
  IFS='/' read -ra parts <<< "$path"
  [[ ${#parts[@]} -ge 2 ]] || die 'Invalid GitHub source: expected owner/repository'

  parts[1]="${parts[1]%.git}"
  REPOSITORY_PATH="${parts[0]}/${parts[1]}"
  REMOTE_URL="$FORGE_ORIGIN/$REPOSITORY_PATH.git"

  if [[ $raw_host == true ]]; then
    resolve_ref_path "$(_join_with_slash "${parts[@]:2}")" true
  elif [[ ${#parts[@]} -gt 3 && ${parts[2]} =~ ^(blob|tree|raw)$ ]]; then
    resolve_ref_path "$(_join_with_slash "${parts[@]:3}")" true
  elif [[ ${#parts[@]} -gt 2 ]]; then
    resolve_ref_path "$(_join_with_slash "${parts[@]:2}")" false
  else
    SOURCE_REF=''
    SOURCE_PATH=''
  fi
}

parse_gitlab_path() {
  local path="${1#/}" marker_index=-1 index
  local -a parts=()
  IFS='/' read -ra parts <<< "$path"

  for ((index = 1; index + 2 < ${#parts[@]}; index++)); do
    if [[ ${parts[index]} == '-' && ${parts[index + 1]} =~ ^(blob|raw|tree)$ ]]; then
      marker_index=$index
      break
    fi
  done

  if ((marker_index >= 0)); then
    ((marker_index >= 2)) || die 'Invalid GitLab source: expected namespace/repository before /-/'
    REPOSITORY_PATH=$(_join_with_slash "${parts[@]:0:marker_index}")
    REPOSITORY_PATH="${REPOSITORY_PATH%.git}"
    REMOTE_URL="$FORGE_ORIGIN/$REPOSITORY_PATH.git"
    resolve_ref_path "$(_join_with_slash "${parts[@]:marker_index+2}")" true
  else
    [[ ${#parts[@]} -ge 2 ]] || die 'Invalid GitLab source: expected namespace/repository'
    REPOSITORY_PATH=$(_join_with_slash "${parts[@]}")
    REPOSITORY_PATH="${REPOSITORY_PATH%.git}"
    REMOTE_URL="$FORGE_ORIGIN/$REPOSITORY_PATH.git"
    SOURCE_REF=''
    SOURCE_PATH=''
  fi
}

parse_forgejo_path() {
  local path="${1#/}" marker ref_kind
  local -a parts=()
  IFS='/' read -ra parts <<< "$path"
  [[ ${#parts[@]} -ge 2 ]] || die 'Invalid Forgejo/Gitea source: expected owner/repository'

  parts[1]="${parts[1]%.git}"
  REPOSITORY_PATH="${parts[0]}/${parts[1]}"
  REMOTE_URL="$FORGE_ORIGIN/$REPOSITORY_PATH.git"

  if [[ ${#parts[@]} -eq 2 ]]; then
    SOURCE_REF=''
    SOURCE_PATH=''
    return
  fi

  marker="${parts[2]}"
  if [[ ${#parts[@]} -lt 5 || ! $marker =~ ^(src|raw)$ || ! ${parts[3]} =~ ^(branch|tag|commit)$ ]]; then
    die 'Unsupported Forgejo/Gitea source; use /src/{branch|tag|commit}/ref/path or /raw/{branch|tag|commit}/ref/path'
  fi

  ref_kind="${parts[3]}"
  if [[ $ref_kind == commit ]]; then
    local remaining
    remaining=$(_join_with_slash "${parts[@]:4}")
    IFS='/' read -ra parts <<< "$remaining"
    SOURCE_REF="${parts[0]}"
    SOURCE_REF_KIND='commit'
    SOURCE_OID="${parts[0]}"
    SOURCE_PATH=$(_join_with_slash "${parts[@]:1}")
  else
    resolve_ref_path "$(_join_with_slash "${parts[@]:4}")" true "$ref_kind"
  fi
}

parse_source() {
  local input="$1" path='' host='' origin='' first=''
  input="${input%%#*}"
  input="${input%%\?*}"
  resolve_forge_option

  case "$input" in
    https://raw.githubusercontent.com/*|http://raw.githubusercontent.com/*)
      host='github.com'
      origin="${input%%://*}://github.com"
      path=$(_url_path "$input")
      set_source_forge "$host" "$origin"
      path=$(git_forge_urldecode_path "$path")
      parse_github_path "$path" true
      return
      ;;
  esac

  if [[ $input == *://* ]]; then
    host=$(_url_host "$input")
    origin=$(_url_origin "$input")
    path=$(_url_path "$input")
    set_source_forge "$host" "$origin"
  else
    first="${input%%/*}"
    if [[ $first == *.* ]] && git_forge_find_resolver "$first"; then
      host="$first"
      origin="$GIT_FORGE_MATCHED_ORIGIN"
      path="${input#*/}"
      set_source_forge "$host" "$origin"
    elif [[ -n $OPTION_FORGE_TYPE ]]; then
      FORGE_TYPE="$OPTION_FORGE_TYPE"
      FORGE_HOST="$OPTION_FORGE_HOST"
      FORGE_ORIGIN="$OPTION_FORGE_ORIGIN"
      path="${input#./}"
      path="${path#/}"
    else
      FORGE_TYPE='github'
      FORGE_HOST='github.com'
      FORGE_ORIGIN='https://github.com'
      path="${input#./}"
      path="${path#/}"
    fi
  fi

  path="${path%/}"
  path=$(git_forge_urldecode_path "$path")
  case "$FORGE_TYPE" in
    github) parse_github_path "$path" ;;
    gitlab) parse_gitlab_path "$path" ;;
    forgejo|gitea) parse_forgejo_path "$path" ;;
    *) die "Downloads are not implemented for forge '$FORGE_TYPE'" ;;
  esac
}

# ── API and ref resolution ────────────────────────────────────────────────────

http_get() {
  local url="$1"
  if command -v curl &>/dev/null; then
    curl -fsSL "$url"
  elif command -v wget &>/dev/null; then
    wget -qO- "$url"
  else
    die 'No HTTP client found. Install curl or wget.'
  fi
}

github_api_json() {
  local endpoint="$1" token="${GITHUB_TOKEN:-}"
  if _has_gh; then
    gh api "$endpoint"
  elif command -v curl &>/dev/null; then
    local args=(-fsSL)
    [[ -n $token ]] && args+=(-H "Authorization: Bearer $token")
    curl "${args[@]}" "$GITHUB_API/$endpoint"
  elif command -v wget &>/dev/null; then
    local args=(-qO-)
    [[ -n $token ]] && args+=(--header="Authorization: Bearer $token")
    wget "${args[@]}" "$GITHUB_API/$endpoint"
  else
    die 'No HTTP client found. Install gh CLI, curl, or wget.'
  fi
}

get_default_ref() {
  if [[ $FORGE_TYPE == github ]]; then
    local owner="${REPOSITORY_PATH%%/*}" repository="${REPOSITORY_PATH#*/}" branch
    branch=$(github_api_json "repos/$owner/$repository" | json_field default_branch) || true
    [[ -n $branch ]] || die "Could not determine default branch for $REPOSITORY_PATH"
    SOURCE_REF_KIND='branch'
    SOURCE_REF="$branch"
    return
  fi

  local refs branch oid
  refs=$(git ls-remote --symref "$REMOTE_URL" HEAD 2>/dev/null) || refs=''
  branch=$(awk '$1 == "ref:" && $3 == "HEAD" { sub(/^refs\/heads\//, "", $2); print $2; exit }' <<< "$refs")
  oid=$(awk '$2 == "HEAD" && $1 != "ref:" { print $1; exit }' <<< "$refs")
  [[ -n $branch ]] || die "Could not determine default branch for $FORGE_HOST/$REPOSITORY_PATH"
  SOURCE_REF_KIND='branch'
  SOURCE_OID="$oid"
  SOURCE_REF="$branch"
}

ensure_source_oid() {
  [[ -n $SOURCE_OID ]] && return 0
  if [[ $SOURCE_REF_KIND == commit && $SOURCE_REF =~ ^[0-9a-fA-F]{7,40}$ ]]; then
    SOURCE_OID="$SOURCE_REF"
    return
  fi

  local kind name oid peeled
  while IFS=$'\t' read -r kind name oid peeled; do
    if [[ $name == "$SOURCE_REF" ]]; then
      if [[ -z $SOURCE_OID || $peeled == true ]]; then
        SOURCE_OID="$oid"
      fi
    fi
  done < <(matching_ref_records "${SOURCE_REF%%/*}" "$SOURCE_REF_KIND")
}

# ── Output path resolution ────────────────────────────────────────────────────

resolve_file_output() {
  local dest="$1" filename="$2"
  if [[ -z $dest ]]; then
    printf './%s' "$filename"
  elif [[ $dest == */ ]]; then
    printf '%s%s' "$dest" "$filename"
  elif [[ -d $dest ]]; then
    printf '%s/%s' "${dest%/}" "$filename"
  else
    printf '%s' "$dest"
  fi
}

resolve_dir_output() {
  local dest="$1" dirname="$2"
  if [[ -z $dest ]]; then
    printf './%s' "$dirname"
  elif [[ $dest == */ ]]; then
    printf '%s%s' "$dest" "$dirname"
  elif [[ -d $dest ]]; then
    printf '%s/%s' "${dest%/}" "$dirname"
  else
    printf '%s' "$dest"
  fi
}

# ── Download and tree adapters ────────────────────────────────────────────────

resolved_file_url() {
  git_forge_raw_file_url "$FORGE_TYPE" "$FORGE_ORIGIN" "$REPOSITORY_PATH" "$SOURCE_REF" "$1" ||
    die "Could not construct a raw URL for $FORGE_TYPE"
}

queue_download_plan() {
  local path="$1" output="$2"
  DRY_RUN_URLS+=("$(resolved_file_url "$path")")
  DRY_RUN_DESTINATIONS+=("$output")
  if [[ -e $output || -L $output ]]; then
    DRY_RUN_WARNING_PATHS+=("$output")
  fi
}

markdown_code_span() {
  local value="$1" fence='`'
  while [[ $value == *"$fence"* ]]; do
    fence+='`'
  done
  printf '%s %s %s' "$fence" "$value" "$fence"
}

markdown_table_code_span() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//|/\\|}"
  markdown_code_span "$value"
}

find_gum_command() {
  local executable
  executable=$(command -v gum 2>/dev/null) ||
    executable=$(command -v gum.exe 2>/dev/null) || return 1
  printf '%s' "$executable"
}

find_fold_command() {
  local executable
  executable=$(command -v fold 2>/dev/null) ||
    executable=$(command -v fold.exe 2>/dev/null) || return 1
  printf '%s' "$executable"
}

dry_run_output_width() {
  local width="${COLUMNS:-}"
  if [[ -t 1 ]] && command -v tput &>/dev/null; then
    width=$(tput cols 2>/dev/null) || true
  fi
  [[ $width =~ ^[0-9]+$ && $width -ge 20 ]] || width=120
  printf '%s' "$width"
}

fold_pretty_value() {
  local value="$1" width="$2" fold_command="$3" prepared="$1" folded
  if [[ -z $fold_command ]]; then
    printf '%s\n' "$value"
  elif [[ $value == */* ]] && command -v sed &>/dev/null; then
    # Temporary spaces after separators give fold preferred break points. The
    # hard width still applies to an individual path segment with no slashes.
    if [[ $value =~ ^([A-Za-z][A-Za-z0-9+.-]*://)(.*)$ ]]; then
      # Keep the scheme delimiter intact, but allow a break immediately after
      # it so a narrow column does not force a split inside the hostname.
      prepared="${BASH_REMATCH[1]} ${BASH_REMATCH[2]//\//\/ }"
    else
      prepared="${value//\//\/ }"
    fi
    if folded=$(printf '%s' "$prepared" |
      "$fold_command" -s -w "$width" |
      sed 's#/ #/#g'); then
      printf '%s\n' "$folded"
    else
      printf '%s\n' "$value"
    fi
  else
    if folded=$(printf '%s' "$value" | "$fold_command" -w "$width"); then
      printf '%s\n' "$folded"
    else
      printf '%s\n' "$value"
    fi
  fi
}

write_tsv_download_plan() {
  local index warning_path
  printf 'Download files\tDestination\n'
  for ((index = 0; index < ${#DRY_RUN_URLS[@]}; index++)); do
    printf '%s\t%s\n' "${DRY_RUN_URLS[index]}" "${DRY_RUN_DESTINATIONS[index]}"
  done
  for warning_path in "${DRY_RUN_WARNING_PATHS[@]}"; do
    printf '%s: Warning: %s already exists and would be overwritten\n' \
      "$PROG" "$warning_path" >&2
  done
}

write_markdown_download_plan() {
  local fold_command="$1" width column_width index row row_count warning_path
  local -a url_chunks=() destination_chunks=() warning_chunks=()
  width=$(dry_run_output_width)
  column_width=$(((width - 16) / 2))
  ((column_width >= 20)) || column_width=20

  printf '| Download files | Destination |\n'
  printf '| -------------- | ----------- |\n'
  for ((index = 0; index < ${#DRY_RUN_URLS[@]}; index++)); do
    url_chunks=()
    destination_chunks=()
    if [[ -n $fold_command ]]; then
      mapfile -t url_chunks < <(fold_pretty_value "${DRY_RUN_URLS[index]}" "$column_width" "$fold_command")
      mapfile -t destination_chunks < <(fold_pretty_value "${DRY_RUN_DESTINATIONS[index]}" "$column_width" "$fold_command")
    else
      url_chunks=("${DRY_RUN_URLS[index]}")
      destination_chunks=("${DRY_RUN_DESTINATIONS[index]}")
    fi
    ((${#url_chunks[@]})) || url_chunks=('')
    ((${#destination_chunks[@]})) || destination_chunks=('')
    row_count=${#url_chunks[@]}
    ((${#destination_chunks[@]} > row_count)) && row_count=${#destination_chunks[@]}
    for ((row = 0; row < row_count; row++)); do
      local url_cell='' destination_cell=''
      [[ -z ${url_chunks[row]+set} ]] || url_cell=$(markdown_table_code_span "${url_chunks[row]}")
      [[ -z ${destination_chunks[row]+set} ]] || destination_cell=$(markdown_table_code_span "${destination_chunks[row]}")
      printf '| %s | %s |\n' "$url_cell" "$destination_cell"
    done
  done

  for warning_path in "${DRY_RUN_WARNING_PATHS[@]}"; do
    printf '\n> **Warning:** Destination already exists and would be overwritten.\n'
    warning_chunks=()
    if [[ -n $fold_command ]]; then
      mapfile -t warning_chunks < <(fold_pretty_value "$warning_path" "$column_width" "$fold_command")
    else
      warning_chunks=("$warning_path")
    fi
    for row in "${warning_chunks[@]}"; do
      printf '\n> %s\n' "$(markdown_code_span "$row")"
    done
  done
}

write_pretty_download_plan() {
  local gum_command="$1" markdown formatted fold_command=''
  fold_command=$(find_fold_command) || fold_command=''
  markdown=$(write_markdown_download_plan "$fold_command")

  if ! formatted=$(printf '%s\n' "$markdown" | CLICOLOR_FORCE=1 "$gum_command" format --language markdown); then
    return 1
  fi
  printf '%s\n' "$formatted"
}

render_download_plan() {
  ((${#DRY_RUN_URLS[@]})) || return 0
  local gum_command=''
  case "$COLOR_MODE" in
    always) gum_command=$(find_gum_command) || gum_command='' ;;
    auto)
      if [[ -t 1 ]]; then
        gum_command=$(find_gum_command) || gum_command=''
      fi
      ;;
  esac

  if [[ -n $gum_command ]] && write_pretty_download_plan "$gum_command"; then
    return 0
  fi
  write_tsv_download_plan
}

download_file() {
  local path="$1" output="$2" token="${GITHUB_TOKEN:-}" url

  if _has_gh; then
    local owner="${REPOSITORY_PATH%%/*}" repository="${REPOSITORY_PATH#*/}"
    local encoded_ref encoded_path
    encoded_ref=$(git_forge_urlencode_component "$SOURCE_REF")
    encoded_path=$(git_forge_urlencode_path "$path")
    gh api "repos/$owner/$repository/contents/$encoded_path?ref=$encoded_ref" \
      -H 'Accept: application/vnd.github.raw+json' > "$output"
  elif command -v curl &>/dev/null; then
    url=$(resolved_file_url "$path")
    local args=(-fsSL "$url" -o "$output")
    [[ $FORGE_TYPE == github && -n $token ]] && args+=(-H "Authorization: Bearer $token")
    curl "${args[@]}"
  elif command -v wget &>/dev/null; then
    url=$(resolved_file_url "$path")
    local args=(-qO "$output")
    [[ $FORGE_TYPE == github && -n $token ]] && args+=(--header="Authorization: Bearer $token")
    wget "${args[@]}" "$url"
  else
    die 'No HTTP client found. Install gh CLI, curl, or wget.'
  fi
}

github_container_paths() {
  local path="$1" encoded_ref tree_json truncated
  encoded_ref=$(git_forge_urlencode_component "$SOURCE_REF")
  tree_json=$(github_api_json "repos/$REPOSITORY_PATH/git/trees/$encoded_ref?recursive=1")
  truncated=$(printf '%s' "$tree_json" | json_field truncated) || true
  [[ $truncated == true ]] && info 'Warning: tree is truncated; some files may be missing'
  printf '%s' "$tree_json" | json_tree_paths "$path"
}

gitlab_container_paths() {
  local path="$1" encoded_repository encoded_ref encoded_path base page=1 page_json page_count page_files
  local files=''
  encoded_repository=$(git_forge_urlencode_component "$REPOSITORY_PATH")
  encoded_ref=$(git_forge_urlencode_component "$SOURCE_REF")
  base="$FORGE_ORIGIN/api/v4/projects/$encoded_repository/repository/tree?recursive=true&per_page=100&ref=$encoded_ref"
  if [[ -n $path ]]; then
    encoded_path=$(git_forge_urlencode_component "$path")
    base+="&path=$encoded_path"
  fi

  while :; do
    page_json=$(http_get "$base&page=$page") || die "Could not list GitLab tree at '$path'"
    page_count=$(printf '%s' "$page_json" | json_array_length)
    page_files=$(printf '%s' "$page_json" | json_gitlab_tree_paths)
    if [[ -n $page_files ]]; then
      [[ -n $files ]] && files+=$'\n'
      files+="$page_files"
    fi
    ((page_count < 100)) && break
    page=$((page + 1))
  done
  printf '%s' "$files"
}

forgejo_container_paths() {
  local path="$1" treeish encoded_treeish base page=1 page_json page_files truncated
  local files=''
  ensure_source_oid
  treeish="${SOURCE_OID:-$SOURCE_REF}"
  encoded_treeish=$(git_forge_urlencode_component "$treeish")
  base="$FORGE_ORIGIN/api/v1/repos/$REPOSITORY_PATH/git/trees/$encoded_treeish?recursive=true&per_page=1000"

  while :; do
    page_json=$(http_get "$base&page=$page") || die "Could not list $FORGE_TYPE tree at '$path'"
    page_files=$(printf '%s' "$page_json" | json_tree_paths "$path")
    if [[ -n $page_files ]]; then
      [[ -n $files ]] && files+=$'\n'
      files+="$page_files"
    fi
    truncated=$(printf '%s' "$page_json" | json_field truncated) || true
    [[ $truncated == true ]] || break
    page=$((page + 1))
    ((page <= 1000)) || die 'Forgejo/Gitea tree pagination exceeded 1000 pages'
  done
  printf '%s' "$files"
}

container_paths() {
  case "$FORGE_TYPE" in
    github) github_container_paths "$1" ;;
    gitlab) gitlab_container_paths "$1" ;;
    forgejo|gitea) forgejo_container_paths "$1" ;;
    *) die "Directory downloads are not implemented for forge '$FORGE_TYPE'" ;;
  esac
}

download_container() {
  local output_dir="$1" path="${SOURCE_PATH%/}" files count=0
  info "Fetching repository tree ($FORGE_HOST/$REPOSITORY_PATH @ $SOURCE_REF)..."
  files=$(container_paths "$path")
  [[ -n $files ]] || die "No files found at '$path'; check the source URL"

  local file_path rel out
  while IFS= read -r file_path; do
    if [[ -n $path ]]; then
      rel="${file_path#"$path"/}"
    else
      rel="$file_path"
    fi
    [[ -n $rel ]] || rel=$(basename "$file_path")
    out="$output_dir/$rel"

    if $DRY_RUN; then
      queue_download_plan "$file_path" "$out"
    else
      mkdir -p "$(dirname "$out")"
      info "downloading $rel"
      download_file "$file_path" "$out"
    fi
    count=$((count + 1))
  done <<< "$files"

  if $DRY_RUN; then
    render_download_plan
    info "Dry run: $count file(s) would be downloaded to $output_dir"
  else
    info "Downloaded $count file(s) to $output_dir"
  fi
}

# ── Main ──────────────────────────────────────────────────────────────────────

main() {
  local source_value='' dest='' container=false help=false
  local -a positional=()

  while (($#)); do
    case "$1" in
      -h|--help|help) help=true ;;
      -c|--container) container=true ;;
      --dry-run) DRY_RUN=true ;;
      --color)
        (($# >= 2)) || die 'Missing value for --color'
        COLOR_MODE="$2"
        shift
        ;;
      --color=*) COLOR_MODE="${1#*=}" ;;
      --gh) USE_GH=true ;;
      --no-gh) USE_GH=false ;;
      --forge)
        (($# >= 2)) || die 'Missing value for --forge'
        FORGE_OPTION="$2"
        shift
        ;;
      --forge=*) FORGE_OPTION="${1#*=}" ;;
      --) shift; positional+=("$@"); break ;;
      -*) die "Unknown option: $1" ;;
      *) positional+=("$1") ;;
    esac
    shift
  done

  $help && { show_help; exit 0; }
  case "$COLOR_MODE" in
    auto|always|never) ;;
    *) die "Invalid --color value '$COLOR_MODE' (expected auto, always, or never)" ;;
  esac
  [[ ${#positional[@]} -gt 0 ]] || { show_help; exit 1; }
  [[ ${#positional[@]} -le 2 ]] || die 'Too many positional arguments'

  source_value="${positional[0]}"
  dest="${positional[1]:-}"
  parse_source "$source_value"
  [[ -n $REPOSITORY_PATH ]] || die "Could not parse repository from: $source_value"

  if [[ -z $SOURCE_REF ]]; then
    info 'Resolving default branch...'
    get_default_ref
  fi

  if $container; then
    local dir_name out_dir
    if [[ -n $SOURCE_PATH ]]; then
      dir_name=$(basename "${SOURCE_PATH%/}")
    else
      dir_name="${REPOSITORY_PATH##*/}"
    fi
    [[ -n $dir_name && $dir_name != . ]] || dir_name="${REPOSITORY_PATH##*/}"
    out_dir=$(resolve_dir_output "$dest" "$dir_name")
    $DRY_RUN || mkdir -p "$out_dir"
    download_container "$out_dir"
  else
    [[ -n $SOURCE_PATH ]] || die 'No file path in source; use -c/--container to download a directory'
    local filename output parent
    filename=$(basename "$SOURCE_PATH")
    [[ -n $filename && $filename != . ]] || die "Could not determine filename from: $SOURCE_PATH"
    output=$(resolve_file_output "$dest" "$filename")
    if $DRY_RUN; then
      queue_download_plan "$SOURCE_PATH" "$output"
      render_download_plan
    else
      parent=$(dirname "$output")
      [[ $parent == . ]] || mkdir -p "$parent"
      download_file "$SOURCE_PATH" "$output"
      info "Downloaded to $output"
    fi
  fi
}

main "$@"
